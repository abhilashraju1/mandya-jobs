# Mandya Jobs Environment Configuration Template
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Brand Configuration
NEXT_PUBLIC_BRAND_NAME="Mandya Jobs"
NEXT_PUBLIC_BRAND_LOCAL_NAME="ಮಂಡ್ಯ ಜಾಬ್ಸ್"
NEXT_PUBLIC_DEFAULT_CITY="Mandya"
NEXT_PUBLIC_DEFAULT_STATE="Karnataka"

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mandya_jobs?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & Authentication
JWT_SECRET=super-secret-development-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super-secret-refresh-token-key-replace-in-prod
REFRESH_TOKEN_EXPIRES_IN=30d

# OTP Provider (Options: 'mock', 'twilio', 'msg91')
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
MOCK_OTP_CODE=123456

# Storage (R2 / S3 / MinIO compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=mandya-jobs-resumes
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=http://localhost:9000/mandya-jobs-resumes

# Security & CORS
CORS_ORIGIN=http://localhost:3000
ADMIN_MFA_ENABLED=false
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
