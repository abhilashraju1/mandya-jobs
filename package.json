{
  "name": "mandya-jobs",
  "version": "1.0.0",
  "private": true,
  "description": "Mandya Jobs - Production-oriented Kannada/English PWA connecting local job seekers with verified employers",
  "author": "appuabhiraj@gmail.com",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "tsx scripts/run-tests.js",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:all": "tsx scripts/run-tests.js && tsx scripts/test-e2e.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:up": "docker compose up -d postgres redis minio",
    "db:down": "docker compose down",
    "db:migrate": "turbo run db:migrate --filter=@mandya-jobs/api",
    "db:seed": "turbo run db:seed --filter=@mandya-jobs/api",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "cf:build": "pnpm --filter=@mandya-jobs/web build",
    "cf:deploy": "wrangler pages deploy apps/web/.vercel/output/static --project-name=mandya-jobs"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "wrangler": "^4.163.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
